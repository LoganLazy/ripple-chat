{
  "name": "ripple-chat",
  "productName": "Ripple",
  "version": "0.3.0",
  "description": "A thoughtful Matrix messenger · 涟漪",
  "author": "Ripple",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5188",
    "desktop": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test": "playwright test",
    "format": "prettier --write src electron tests *.ts *.json index.html"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "matrix-js-sdk": "^45.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@fontsource/noto-emoji": "^5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.4.0",
    "prettier": "^3.6.0"
  },
  "build": {
    "appId": "chat.ripple.desktop",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.social-networking"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
